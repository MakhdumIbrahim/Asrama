{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/build/assets/(.+)\\.css",
      "dest": "/build/assets/$1.css",
      "headers": { "Content-Type": "text/css; charset=utf-8" }
    },
    {
      "src": "/build/assets/(.+)\\.js",
      "dest": "/build/assets/$1.js",
      "headers": { "Content-Type": "application/javascript; charset=utf-8" }
    },
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/storage/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "outputDirectory": "public"
}