{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "shyim/serverless-php@0.4.4"
    }
  },
  "routes": [
    {
      "src": "/(css|js|images|storage|build|favicon.ico)(.*)",
      "dest": "/public/$1$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}